<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bestText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_card"
            android:padding="12dp"
            android:text="🏆 BEST: 0"
            android:textColor="@color/mint"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/gemsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="💎 GEMS: 0"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CHOOSE YOUR MODE"
            android:textColor="@color/mint" />

        <Button
            android:id="@+id/btn_learn"
            style="@style/PrimaryButton"
            android:text="📚 Learn Lab" />

        <Button
            android:id="@+id/btn_practice"
            style="@style/PrimaryButton"
            android:text="🎯 Practice" />

        <Button
            android:id="@+id/btn_speed"
            style="@style/PrimaryButton"
            android:text="⚡ Speed Rush" />

        <Button
            android:id="@+id/btn_survival"
            style="@style/PrimaryButton"
            android:text="❤️ Survival" />

        <Button
            android:id="@+id/btn_memory"
            style="@style/PrimaryButton"
            android:text="🧠 Memory Match" />

        <Button
            android:id="@+id/btn_boss"
            style="@style/PrimaryButton"
            android:text="👑 Boss Battle" />
    </LinearLayout>
</ScrollView>
